# Salin jadi .env lalu isi. File .env TIDAK masuk Git.

# ── Dipakai backend (Docker maupun venv) ──────────────────────────────
JWT_SECRET_KEY="ganti-dengan-string-acak-panjang"
JWT_SECRET="nilai-yang-sama-dengan-JWT_SECRET_KEY"
RTSP_URL="rtsp://192.168.2.2:8554/cam"
MEDIAMTX_URL="http://192.168.2.2:8889/cam/"
RASPI_TELEMETRY_URL="http://192.168.2.2:14552/telemetry"

# ── Hanya untuk menjalankan tanpa Docker (npm run dev + venv) ────────
DATABASE_URL="mysql://root:password@localhost:3306/carter_island"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_STREAM_PREVIEW_URL="http://localhost:8889/cam/"

# ── Hanya untuk Docker (docker compose up -d --build) ────────────────
# IP mesin yang menjalankan Docker, seperti diketik di browser operator (mis. IP Orin).
# Ganti → `docker compose build frontend` lalu `docker compose up -d`.
PUBLIC_HOST="localhost"
STREAM_PREVIEW_URL="http://localhost:8889/cam/"

# Database di container (password tanpa karakter @ : / ?)
MYSQL_DATABASE="deepsight"
MYSQL_USER="deepsight"
MYSQL_PASSWORD="ganti-password"
MYSQL_ROOT_PASSWORD="ganti-password-root"
MYSQL_PORT="3307"

# Pilih SATU pasangan sesuai mesin:
# Laptop tanpa GPU NVIDIA:
BACKEND_BASE_IMAGE="ultralytics/ultralytics:latest-cpu"
# Laptop dengan GPU NVIDIA (Windows: pemisah file pakai titik koma):
#BACKEND_BASE_IMAGE="ultralytics/ultralytics:latest"
#COMPOSE_FILE="docker-compose.yml;docker-compose.gpu.yml"
#COMPOSE_PATH_SEPARATOR=";"
# Jetson Orin JetPack 6 (JetPack 5: ganti jetpack6 → jetpack5):
#BACKEND_BASE_IMAGE="ultralytics/ultralytics:latest-jetson-jetpack6"
#COMPOSE_FILE="docker-compose.yml:docker-compose.orin.yml"
