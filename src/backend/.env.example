# RTSP Stream Configuration
RTSP_URL=rtsp://192.168.2.2:8554/cam
RTSP_TRANSPORT=udp

# Video Processing
TARGET_FPS=30
RESIZE_WIDTH=1280
RESIZE_HEIGHT=720

# Bitrate Control
MAX_BITRATE_KBPS=4500
MIN_BITRATE_KBPS=2500
BITRATE_REAPPLY_SEC=4.0
PREFER_CODEC=h264
DISABLE_TWCC_REMB=1

# Database Saving Configuration
# Aktifkan penyimpanan deteksi ikan ke database
SAVE_DETECTIONS_ENABLED=true

# URL API Next.js (sesuaikan dengan port Next.js Anda)
API_BASE_URL=http://localhost:3000

# Interval penyimpanan (dalam detik)
# Deteksi akan disimpan setiap X detik jika ada ikan terdeteksi
SAVE_INTERVAL_SECONDS=5.0

# Minimal jumlah ikan yang harus terdeteksi untuk disimpan
# Set ke 1 untuk menyimpan semua deteksi, atau lebih tinggi untuk filter
MIN_DETECTIONS_TO_SAVE=1

# ==============================
# Akses dari browser (LAN / HTTPS)
# ==============================
# Origin frontend yang boleh memanggil API & membuka WebSocket, dipisah koma.
# Default hanya localhost. Kalau dashboard dibuka dari laptop lain di jaringan
# ROV, tambahkan alamat frontend persis seperti di address bar browser:
#   CORS_ORIGINS=http://192.168.2.10:3000,http://localhost:3000
# '*' tidak diizinkan (backend menolak start).
# Ingat juga: NEXT_PUBLIC_API_URL di .env frontend harus berisi IP LAN backend,
# mis. http://192.168.2.10:8000 (bukan localhost).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# true HANYA kalau frontend & backend diakses lewat HTTPS.
# Di HTTP biasa biarkan false — cookie Secure dibuang browser, login tidak bertahan.
COOKIE_SECURE=false
